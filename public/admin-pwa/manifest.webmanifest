{
  "id": "/admin",
  "name": "OP Admin",
  "short_name": "OP Admin",
  "description": "OP Institute & OP Kids staff app — manage queries, events, gallery and settings.",
  "start_url": "/admin?source=pwa",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#1d2951",
  "theme_color": "#1d2951",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["business", "productivity", "education"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/admin-pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Queries",
      "short_name": "Queries",
      "url": "/admin/queries",
      "icons": [{ "src": "/admin-pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Events",
      "short_name": "Events",
      "url": "/admin/events",
      "icons": [{ "src": "/admin-pwa/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/admin/settings",
      "icons": [{ "src": "/admin-pwa/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
